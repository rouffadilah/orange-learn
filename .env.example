# Copy to .env for local development. Never commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Gemini API (Google AI Studio)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Fast interactive model + automatic failover.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=4
GEMINI_MAX_OUTPUT_TOKENS=1800
GEMINI_TEMPERATURE=0.2
